<Window x:Class="DemoExam2.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Каталог товаров" Height="620" Width="1000"
        Background="White" FontFamily="Times New Roman" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Icon.png" Margin="10" Width="50" Height="50" Stretch="Uniform"/>
                <TextBlock Text="Каталог товаров" FontSize="25" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="10"/>
            </StackPanel>
            <TextBlock Name="UserName" Text="Гость" HorizontalAlignment="Right" Margin="10"/>
        </StackPanel>

        <StackPanel Name="FilterPanel" Grid.Row="1" Margin="8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Name="SearchBox" Width="170" Height="26" Margin="4" Background="#7FFF00"
                         FontSize="18" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Name="SortBox" Width="175" Height="26" Margin="4" Background="#7FFF00"
                          SelectionChanged="FilterBox_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="Количество по возрастанию"/>
                    <ComboBoxItem Content="Количество по убыванию"/>
                </ComboBox>
                <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Name="FactoryBox" Width="155" Height="26" Margin="4" Background="#7FFF00"
                          SelectionChanged="FilterBox_SelectionChanged"/>
            </StackPanel>
            <StackPanel Name="AdminPanel" Orientation="Horizontal" Visibility="Collapsed">
                <Button Content="Добавить товар" Margin="4" Padding="8,3" Background="#00FA9A" Click="AddButton_Click"/>
                <Button Content="Изменить" Margin="4" Padding="8,3" Background="#00FA9A" Click="EditButton_Click"/>
                <Button Content="Удалить" Margin="4" Padding="8,3" Background="#00FA9A" Click="DeleteButton_Click"/>
            </StackPanel>
        </StackPanel>

        <ListBox Name="ProductList" Grid.Row="2" SelectedValuePath="Id"
                 d:ItemsSource="{d:SampleData ItemCount=2}"
                 HorizontalContentAlignment="Stretch" MouseDoubleClick="ProductList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="3" Padding="5" Background="{Binding RowColor}">
                        <Grid MinHeight="115">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Image}" Width="100" Height="100" Margin="5" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="5">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Manufacturer}"/>
                                <TextBlock Text="{Binding Factory}"/>
                                <TextBlock>
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding Price, Mode=OneWay}"/>
                                    <Run Text=" руб."/>
                                    <Run Text="{Binding DiscountedPrice, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Unit}"/>
                                <TextBlock Text="{Binding CountText}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DiscountText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="3" Content="Выйти" Margin="5" Background="#00FA9A" HorizontalAlignment="Left"
                Click="ExitButton_Click"/>
    </Grid>
</Window>
