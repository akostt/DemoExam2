<Window x:Class="DemoExam2.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="720" Width="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Times New Roman"
        Icon="/Image/Icon.ico" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Name="IdLabel" Grid.Row="0" Text="ID" VerticalAlignment="Center" Margin="8"/>
            <TextBox Name="IdBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="8" Background="#7FFF00" FontSize="18"/>
            <TextBlock Grid.Row="1" Text="Артикул" VerticalAlignment="Center" Margin="8,0,8,0"/>
            <TextBox Name="ArticulBox" Grid.Row="1" Grid.Column="1" MaxLength="30" Margin="8" Background="#7FFF00" FontSize="18"/>
            <TextBlock Grid.Row="2" Text="Наименование" VerticalAlignment="Center" Margin="8,0,8,0"/>
            <TextBox Name="NameBox" Grid.Row="2" Grid.Column="1" MaxLength="100" Margin="8" Background="#7FFF00" FontSize="18"/>
            <TextBlock Grid.Row="3" Text="Категория" VerticalAlignment="Center" Margin="8"/>
            <ComboBox Name="CategoryBox" Grid.Row="3" Grid.Column="1" DisplayMemberPath="Name"
                      SelectedValuePath="Id" Margin="8" Background="#7FFF00"/>
            <TextBlock Grid.Row="4" Text="Описание" VerticalAlignment="Center" Margin="8"/>
            <TextBox Name="DescriptionBox" Grid.Row="4" Grid.Column="1" Height="65" MaxLength="1000"
                     TextWrapping="Wrap" AcceptsReturn="True" Margin="8" Background="#7FFF00" FontSize="18"/>
            <TextBlock Grid.Row="5" Text="Производитель" VerticalAlignment="Center" Margin="8"/>
            <ComboBox Name="ManufacturerBox" Grid.Row="5" Grid.Column="1" DisplayMemberPath="Name"
                      SelectedValuePath="Id" Margin="8" Background="#7FFF00"/>
            <TextBlock Grid.Row="6" Text="Поставщик" VerticalAlignment="Center" Margin="8"/>
            <ComboBox Name="FactoryBox" Grid.Row="6" Grid.Column="1" DisplayMemberPath="Name"
                      SelectedValuePath="Id" Margin="8" Background="#7FFF00"/>
            <TextBlock Grid.Row="7" Text="Цена" VerticalAlignment="Center" Margin="8"/>
            <TextBox Name="PriceBox" Grid.Row="7" Grid.Column="1" Margin="8" Background="#7FFF00" FontSize="18"/>
            <TextBlock Grid.Row="8" Text="Единица измерения" VerticalAlignment="Center" Margin="8"/>
            <ComboBox Name="UnitBox" Grid.Row="8" Grid.Column="1" DisplayMemberPath="Name"
                      SelectedValuePath="Id" Margin="8" Background="#7FFF00"/>
            <TextBlock Grid.Row="9" Text="Количество на складе" VerticalAlignment="Center" Margin="8"/>
            <TextBox Name="CountBox" Grid.Row="9" Grid.Column="1" Margin="8" Background="#7FFF00" FontSize="18"/>
            <TextBlock Grid.Row="10" Text="Скидка, %" VerticalAlignment="Center" Margin="8"/>
            <TextBox Name="DiscountBox" Grid.Row="10" Grid.Column="1" Margin="8" Background="#7FFF00" FontSize="18"/>
            <TextBlock Grid.Row="11" Text="Фото" VerticalAlignment="Center" Margin="8"/>
            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="8">
                <Image Name="PhotoPreview" Width="110" Height="90" Stretch="Uniform"
                       Source="/Image/picture.png" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Name="PhotoName" Text="Фото не выбрано" TextWrapping="Wrap" Width="220"/>
                    <Button Content="Выбрать фото" Margin="0,6,0,0" Padding="8,3" Background="#00FA9A" Click="ChoosePhotoButton_Click"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="8,12">
                <Button Content="Сохранить" Width="110" Margin="0,0,8,0" Background="#00FA9A"
                        IsDefault="True" Click="SaveButton_Click"/>
                <Button Content="Отмена" Width="110" Background="#00FA9A" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
