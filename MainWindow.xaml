<Window x:Class="DemoExam2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="450" Width="800"
        Background="White" FontFamily="Times New Roman" FontSize="14">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Авторизация" Margin="30 10" FontSize="20"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Логин" Margin="10 3"/>
        <TextBox Name="LoginEnter" Margin="10 3" Background="#7FFF00" FontSize="18"/>
        <TextBlock Text="Пароль" Margin="10 3"/>
        <PasswordBox Name="PasswordEnter" Margin="10 3" Background="#7FFF00" FontSize="18"/>
        <Button Content="Войти" Margin="30 3" Background="#00FA9A" Click="LoginButton_Click"/>
        <TextBlock Text="Войти как гость" FontSize="12" HorizontalAlignment="Center"
                   Foreground="Blue" MouseDown="GuestLogin_MouseDown"/>
    </StackPanel>
</Window>
